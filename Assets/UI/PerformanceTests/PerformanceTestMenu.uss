:root {
    flex-grow: 1;
}

.performance-menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: rgba(8, 12, 20, 0.58);
    color: rgb(235, 240, 248);
}

.menu-card {
    width: 720px;
    max-width: 92%;
    padding: 32px;
    background-color: rgb(24, 31, 43);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(66, 78, 96);
    border-right-color: rgb(66, 78, 96);
    border-bottom-color: rgb(66, 78, 96);
    border-left-color: rgb(66, 78, 96);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.results-card {
    width: 1200px;
    max-width: 92%;
}


.hidden {
    display: none;
}

.running-test-overlay {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 340px;
    padding: 16px;
    background-color: rgba(24, 31, 43, 0.94);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(66, 78, 96);
    border-right-color: rgb(66, 78, 96);
    border-bottom-color: rgb(66, 78, 96);
    border-left-color: rgb(66, 78, 96);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.running-test-title {
    margin-bottom: 2px;
    color: rgb(248, 250, 253);
    font-size: 16px;
    -unity-font-style: bold;
}

.running-test-count {
    margin-bottom: 10px;
    color: rgb(174, 187, 204);
    font-size: 13px;
}

.running-test-value {
    margin-top: 2px;
    margin-bottom: 2px;
    color: rgb(218, 226, 237);
    font-size: 14px;
}


.menu-button.end-test-button {
    width: 100%;
    margin-top: 14px;
    margin-left: 0;
    background-color: rgb(190, 48, 48);
}

.menu-button.end-test-button:hover {
    background-color: rgb(218, 60, 60);
}

.menu-button.end-test-button:active {
    background-color: rgb(154, 36, 36);
}

.menu-button.end-test-button:disabled {
    color: rgb(137, 146, 160);
    background-color: rgb(52, 59, 70);
}



.menu-heading {
    margin-bottom: 24px;
    color: rgb(248, 250, 253);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.build-configuration-badge {
    align-self: center;
    margin-top: -14px;
    margin-bottom: 16px;
    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 12px;
    color: rgb(196, 209, 226);
    background-color: rgb(38, 48, 63);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.section-heading {
    margin-top: 16px;
    margin-bottom: 10px;
    color: rgb(204, 216, 232);
    font-size: 16px;
    -unity-font-style: bold;
}

.field-group {
    margin-bottom: 14px;
}

.field-row {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
}

.field-label {
    width: 220px;
    min-width: 150px;
    color: rgb(222, 229, 238);
    font-size: 15px;
}

.field-control {
    flex-grow: 1;
    min-width: 180px;
    margin-left: -2px;
    color: rgb(28, 34, 44);
}

.field-control > .unity-base-field__label {
    display: none;
}

.target-frame-rate-dropdown {
    width: 210px;
    min-width: 210px;
    max-width: 210px;
    flex-grow: 0;
    flex-shrink: 0;
}

.target-frame-rate-input {
    flex-grow: 1;
    margin-left: 10px;
}

.frame-rate-delta-input {
    margin-left: 0;
}


.option-row {
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 6px;
}

.option-label {
    width: 220px;
    min-width: 150px;
    color: rgb(222, 229, 238);
    font-size: 15px;
}

.option-toggle {
    flex-grow: 0;
    margin-left: 0;
}

.option-toggle > .unity-base-field__label {
    display: none;
}


.performance-test-tooltip {
    position: absolute;
    width: 350px;
    padding: 10px;
    color: rgb(238, 243, 250);
    background-color: rgb(12, 17, 25);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(83, 98, 120);
    border-right-color: rgb(83, 98, 120);
    border-bottom-color: rgb(83, 98, 120);
    border-left-color: rgb(83, 98, 120);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 13px;
    white-space: normal;
}

.validation-warning {
    min-height: 20px;
    margin-top: 4px;
    margin-left: 218px;
    color: rgb(255, 151, 151);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.physics-update-rate-warning {
    color: rgb(255, 213, 79);
}

.validation-warning-hidden {
    visibility: hidden;
}

.action-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}

.menu-button {
    min-width: 132px;
    height: 40px;
    margin-left: 10px;
    padding-left: 18px;
    padding-right: 18px;
    color: rgb(245, 248, 252);
    background-color: rgb(47, 104, 181);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-style: bold;
}

.menu-button:hover {
    background-color: rgb(61, 123, 205);
}

.menu-button:active {
    background-color: rgb(39, 86, 150);
}

.menu-button:disabled {
    color: rgb(137, 146, 160);
    background-color: rgb(52, 59, 70);
}

.secondary-button {
    color: rgb(225, 231, 240);
    background-color: rgb(66, 75, 89);
}

.secondary-button:hover {
    background-color: rgb(82, 93, 109);
}

.summary-container {
    margin-bottom: 20px;
    padding: 14px;
    background-color: rgb(31, 40, 55);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.summary-label {
    margin-top: 3px;
    margin-bottom: 3px;
    color: rgb(218, 226, 237);
    font-size: 14px;
}

.results-table {
    margin-top: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(66, 78, 96);
    border-right-color: rgb(66, 78, 96);
    border-bottom-color: rgb(66, 78, 96);
    border-left-color: rgb(66, 78, 96);
}

.results-row {
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 66, 82);
}


.results-header {
    background-color: rgb(38, 49, 66);
}

.results-cell {
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(220, 227, 237);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.results-header .results-cell {
    color: rgb(247, 249, 252);
    -unity-font-style: bold;
}

.results-test-name-column {
    flex-grow: 1.4;
    flex-basis: 150px;
}

.results-entity-count-column {
    flex-grow: 0.9;
    flex-basis: 100px;
    -unity-text-align: middle-center;
}

.results-process-cpu-column {
    flex-grow: 0.9;
    flex-basis: 105px;
    -unity-text-align: middle-center;
}

.results-frame-time-column {
    flex-grow: 1.5;
    flex-basis: 175px;
    -unity-text-align: middle-center;
}

.results-memory-column {
    flex-grow: 1;
    flex-basis: 120px;
    -unity-text-align: middle-center;
}
